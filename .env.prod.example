# ============================================================
# SentinelAI — Production Environment Variables
# Copy to .env.prod, fill in all values, NEVER commit .env.prod
# ============================================================

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinelai
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_neo4j_password_here
NEO4J_URI=bolt://neo4j:7687

# --- JWT ---
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_64_char_hex
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# --- Domain & TLS ---
DOMAIN=yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com
# Path on host where fullchain.pem + privkey.pem live (mounted read-only into nginx)
TLS_CERT_DIR=/etc/letsencrypt/live/yourdomain.com

# --- BloodHound CE ---
BLOODHOUND_URL=http://bloodhound:8080
BLOODHOUND_SECRET=CHANGE_ME_bloodhound_jwt_key

# --- AWS (Prowler cloud scans) ---
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=us-east-1

# --- SIEM (optional) ---
SIEM_ENABLED=false
SPLUNK_HEC_URL=https://splunk.internal:8088
SPLUNK_HEC_TOKEN=CHANGE_ME
SPLUNK_INDEX=sentinelai
ES_URL=https://elastic.internal:9200
ES_INDEX=sentinelai-findings
# ES_USER=elastic
# ES_PASSWORD=CHANGE_ME

# --- Slack / Jira integrations (optional) ---
SLACK_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# --- App ---
ENVIRONMENT=production
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
